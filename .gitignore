# Packer build artifacts
packer_cache/
*.box
manifest.json
output-*/
builds/

# Variables with sensitive data. variables.pkrvars.hcl is generated by the
# pipeline (CI values + secrets) and must never be committed.
*.pkrvars.hcl
# CI values are secret-free by design; secrets are appended from CI variables.
!variables.ci.pkrvars.hcl
*.auto.pkrvars.hcl

# Packer crash logs
crash.log

# OS files
.DS_Store
Thumbs.db

# Editor files
.vscode/
.idea/
*.swp
*.swo
*~
.*.sw[a-z]

# Temporary files
*.tmp
*.temp

# Logs
*.log
