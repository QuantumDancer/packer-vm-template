# Copy this file to variables.pkrvars.hcl and fill in your actual values
# DO NOT commit variables.pkrvars.hcl to version control!

# Proxmox Connection
proxmox_url              = "https://your-proxmox-host.example.com:8006/api2/json"
proxmox_username         = "root@pam!packer"
proxmox_token            = "your-api-token-here"
insecure_skip_tls_verify = true # Set to false if using valid SSL certificates
proxmox_node             = "pve" # Your Proxmox node name

# ISO Configuration
iso_file = "local:iso/rhel-9.6-x86_64-dvd.iso" # Adjust to your ISO filename

# VM Configuration
vm_id         = 9001
vm_name       = "rhel9-packer-build"
template_name = "rhel-9-template"

# Hardware Configuration
cpu_cores   = 4
cpu_sockets = 1
memory      = 4096
disk_size   = "10G"

# Storage and Network
storage_pool   = "local-zfs"
network_bridge = "vmbr1"

# SSH Configuration
# Must match the packer user's password hash in kickstart/ks.cfg.
# Generate a new hash with:
#   openssl passwd -6 'your-temporary-password-here'
ssh_username = "packer"
ssh_password = "your-temporary-password-here"
